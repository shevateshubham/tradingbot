# SMC Trading Bot — Environment Variables Template
# ─────────────────────────────────────────────────
# DO NOT put real values here. This file is committed to GitHub.
# Set real values in Railway dashboard → Variables tab.
# ─────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────
# Create bot: message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID or channel ID
# Get it: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Anthropic (weekly self-improvement analysis) ──
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── TradingView Webhook Security ──────────────────
# Choose any strong random password string
# Must match exactly what you put in TradingView alert JSON
TV_WEBHOOK_SECRET=choose_any_strong_password_here

# ── Database (auto-provided by Railway PostgreSQL) ─
# Do NOT set this manually — Railway injects it automatically
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Trading Parameters ────────────────────────────
# Account size in your currency (INR for Indian markets)
ACCOUNT_SIZE=100000

# Risk per trade as a percentage of account (1.0 = 1%)
RISK_PER_TRADE_PERCENT=1.0

# Minimum confluence score to send signal (72 = A grade threshold)
MIN_CONFLUENCE_SCORE=72

# Maximum simultaneously open trades before new signals blocked
MAX_ACTIVE_TRADES=3

# Minimum reward:risk ratio (2.0 = at least 2:1)
MIN_RR_RATIO=2.0

# ── Mode ──────────────────────────────────────────
# true = paper mode (signals sent, no real money alerts)
# false = live mode (enabled via /golive command)
PAPER_MODE=true

# ── GitHub Integration (weekly improvement) ───────
# Personal access token with repo scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Your GitHub username
GITHUB_USERNAME=your_github_username

# Your repository name
GITHUB_REPO=smc-trading-bot

# ── Railway API (rollback feature) ────────────────
# Get from: https://railway.app/account/tokens
RAILWAY_API_TOKEN=your_railway_api_token_here

# Railway service ID (found in Railway dashboard URL)
RAILWAY_SERVICE_ID=your_service_id_here

# Railway project ID
RAILWAY_PROJECT_ID=your_project_id_here
